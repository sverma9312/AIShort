# Copy to services/pipeline/.env for local runs. Never commit .env.
# In GitHub Actions these come from repository secrets.

# Provider order: the first one that works wins. Known: gemini, groq, anthropic.
LLM_PROVIDERS=gemini,groq

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=10

# Groq key (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_RPM=30

# Optional paid fallback: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_RPM=50

# Optional: Supabase project (Settings → API). When set, live runs keep state in Postgres
# instead of services/pipeline/.state/store.json. The service-role key bypasses RLS: keep it secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Discord webhook for alerts (source broken 3 runs in a row, LLM unavailable, all sources down).
DISCORD_WEBHOOK_URL=

# Comma-separated feed base URLs written to meta.json (primary first).
FEED_BASE_URLS=https://example.github.io/AIShort
# Shown in the crawler User-Agent so site owners can contact us.
CONTACT_URL=https://github.com/sverma9312/AIShort
