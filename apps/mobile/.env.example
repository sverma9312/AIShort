# Copy to apps/mobile/.env for local development. EXPO_PUBLIC_* values are compiled into the app
# bundle: never put secrets here. In EAS builds, set them as EAS environment variables.

# Feed location(s), primary first. Default: https://sverma9312.github.io/AIShort
EXPO_PUBLIC_FEED_BASE_URLS=

# Push token registration (Supabase project URL + anon key; RLS limits the key to inserting tokens).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional telemetry. Leave empty to disable.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Native/build config (read by app.config.ts, not compiled into the bundle).
EAS_PROJECT_ID=
