        <mxCell id="overview-lg_e3" value="alerting" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="1445" width="120" height="20" as="geometry"/></mxCell>
        <mxCell id="overview-notes" value="&lt;b&gt;Refresh &amp;amp; latency:&lt;/b&gt; pipeline every 30 min (~1–3 min run) → Pages deploy ~1 min → CDN cache ≤ 10 min → app refreshes on open, pull-to-refresh and hourly in background. &lt;b&gt;Source publishes → card in app ≈ 15–50 min.&lt;/b&gt;&lt;br&gt;&lt;b&gt;Volume:&lt;/b&gt; ~150–300 raw items/day → ~30–60 cards/day after dedupe + filtering.&lt;br&gt;&lt;b&gt;Cost:&lt;/b&gt; infrastructure $0 (GitHub, Supabase, Expo, Sentry, PostHog, cron-job.org free tiers). Store fees: Google Play $25 once, Apple $99/yr. Optional Claude Haiku fallback ~$3–5/mo.&lt;br&gt;&lt;b&gt;Portability:&lt;/b&gt; app reads feed base URLs from meta.json + EAS Update, so the feed can move (Cloudflare Workers / Supabase Storage / custom domain) without a store release." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1060" y="1340" width="980" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pipeline" name="2. Ingestion Pipeline Flow">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="pipeline-title" value="Ingestion Pipeline — one run (GitHub Actions, every 30 min)" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="pipeline-lane1" value="① Collect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="520" height="1060" as="geometry"/></mxCell>
        <mxCell id="pipeline-lane2" value="② Process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6ff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="560" height="1060" as="geometry"/></mxCell>
        <mxCell id="pipeline-lane3" value="③ Publish &amp; notify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3faf2;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1200" y="70" width="560" height="1060" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_start" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;cron */30 · workflow_dispatch" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_load" value="Load sources.yaml + source_health (ETags)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_fetch" value="&lt;b&gt;Fetch all sources in parallel&lt;/b&gt;&lt;br&gt;concurrency 8 · timeout 15 s&lt;br&gt;If-None-Match / If-Modified-Since" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="280" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_ok" value="Got new&lt;br&gt;content (200)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="380" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_health" value="&lt;b&gt;No new items&lt;/b&gt;&lt;br&gt;304 → nothing new&lt;br&gt;error → failures++&lt;br&gt;alert Discord at ≥ 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="380" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_parse" value="&lt;b&gt;Parse items&lt;/b&gt;&lt;br&gt;RSS · Algolia JSON · HF JSON · HTML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="260" height="55" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_norm" value="&lt;b&gt;Normalize&lt;/b&gt;&lt;br&gt;canonical URL (strip utm / AMP)&lt;br&gt;sha256(url) hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="585" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_seen" value="Seen before?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="685" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_skip1" value="Skip" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="705" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_pre" value="&lt;b&gt;Pre-filter&lt;/b&gt;&lt;br&gt;published &amp;lt; 48 h · AI keywords&lt;br&gt;HN points ≥ threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="805" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_pass" value="Passes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="905" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="pipeline-c_skip2" value="Skip" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="925" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="pipeline-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-c_start" target="pipeline-c_load"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-c_load" target="pipeline-c_fetch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-c_fetch" target="pipeline-c_ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-c_ok" target="pipeline-c_health"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-c_ok" target="pipeline-c_parse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-c_parse" target="pipeline-c_norm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-c_norm" target="pipeline-c_seen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-c_seen" target="pipeline-c_skip1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-c_seen" target="pipeline-c_pre"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-c_pre" target="pipeline-c_pass"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-c_pass" target="pipeline-c_skip2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-p_extract" value="&lt;b&gt;Extract full text&lt;/b&gt;&lt;br&gt;Readability + linkedom&lt;br&gt;fallback: RSS description" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_embed" value="&lt;b&gt;Find similar stories (last 48 h)&lt;/b&gt;&lt;br&gt;title trigram (pg_trgm)&lt;br&gt;embedding cosine (pgvector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="210" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_dup" value="Same story as&lt;br&gt;existing cluster?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="310" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_attach" value="&lt;b&gt;Attach to cluster&lt;/b&gt;&lt;br&gt;make primary if source has&lt;br&gt;higher authority&lt;br&gt;(no new card)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="310" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_cluster" value="Create new cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="260" height="45" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_chain" value="&lt;b&gt;LLM provider chain&lt;/b&gt;&lt;br&gt;Gemini Flash-Lite → Groq →&lt;br&gt;Claude Haiku (opt.)&lt;br&gt;failover on 429 / 5xx / timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="430" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_classify" value="&lt;b&gt;LLM classify (batched)&lt;/b&gt;&lt;br&gt;is_ai · category · importance 1–10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="505" width="260" height="55" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_rel" value="is_ai AND&lt;br&gt;importance ≥ 4?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="590" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_reject" value="&lt;b&gt;Store as rejected&lt;/b&gt;&lt;br&gt;kept for prompt tuning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="600" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_sum" value="&lt;b&gt;LLM summarize (grounded in text)&lt;/b&gt;&lt;br&gt;headline ≤ 12 words&lt;br&gt;summary ≤ 60 words" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="710" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_valid" value="Valid? ≤ 60 words,&lt;br&gt;schema OK, facts&lt;br&gt;in source text" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="810" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_retry" value="&lt;b&gt;Retry once&lt;/b&gt;&lt;br&gt;stricter prompt&lt;br&gt;still invalid → drop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="825" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="pipeline-p_upsert" value="&lt;b&gt;Upsert to Supabase&lt;/b&gt;&lt;br&gt;articles · clusters · cards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="950" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="pipeline-e12" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-c_pass" target="pipeline-p_extract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="1030"/><mxPoint x="580" y="1030"/><mxPoint x="580" y="145"/></Array></mxGeometry></mxCell>
        <mxCell id="pipeline-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-p_extract" target="pipeline-p_embed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-p_embed" target="pipeline-p_dup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-p_dup" target="pipeline-p_attach"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-p_dup" target="pipeline-p_cluster"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-p_cluster" target="pipeline-p_classify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;dashed=1;endArrow=none;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-p_chain" target="pipeline-p_classify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-p_classify" target="pipeline-p_rel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e20" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-p_rel" target="pipeline-p_reject"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-p_rel" target="pipeline-p_sum"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-p_sum" target="pipeline-p_valid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e23" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-p_valid" target="pipeline-p_retry"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e24" value="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-p_retry" target="pipeline-p_sum"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="745"/></Array></mxGeometry></mxCell>
        <mxCell id="pipeline-e25" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-p_valid" target="pipeline-p_upsert"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-u_build" value="&lt;b&gt;Build feed files&lt;/b&gt;&lt;br&gt;latest.json: 100 newest visible cards&lt;br&gt;archive/YYYY-MM-DD.json · meta.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1240" y="110" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="pipeline-u_zod" value="Validate with shared Zod schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1240" y="220" width="260" height="45" as="geometry"/></mxCell>
        <mxCell id="pipeline-u_ok" value="Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="295" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="pipeline-u_fail" value="&lt;b&gt;Fail the job&lt;/b&gt;&lt;br&gt;previous deploy stays live&lt;br&gt;alert Discord" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1540" y="300" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="pipeline-u_deploy" value="&lt;b&gt;Deploy&lt;/b&gt;&lt;br&gt;actions/upload-pages-artifact&lt;br&gt;+ actions/deploy-pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1240" y="415" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="pipeline-u_live" value="&lt;b&gt;Live on GitHub Pages CDN&lt;/b&gt;&lt;br&gt;apps see it within ≤ 10 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1240" y="515" width="260" height="55" as="geometry"/></mxCell>
        <mxCell id="pipeline-u_push" value="Any new card with&lt;br&gt;importance ≥ 9 AND&lt;br&gt;pushes today &amp;lt; 2?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="600" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="pipeline-u_nopush" value="No push" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="630" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="pipeline-u_send" value="&lt;b&gt;Send Expo push&lt;/b&gt;&lt;br&gt;tokens from Supabase · batches of 100&lt;br&gt;log in push_log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1240" y="740" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="pipeline-u_house" value="&lt;b&gt;Housekeeping&lt;/b&gt;&lt;br&gt;prune raw text &gt; 30 days&lt;br&gt;update source_health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1240" y="840" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="pipeline-u_end" value="&lt;b&gt;End&lt;/b&gt;&lt;br&gt;~1–3 min total" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="950" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="pipeline-e26" value="after all items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-p_upsert" target="pipeline-u_build"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="1050"/><mxPoint x="1180" y="1050"/><mxPoint x="1180" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="pipeline-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-u_build" target="pipeline-u_zod"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-u_zod" target="pipeline-u_ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e29" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-u_ok" target="pipeline-u_fail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e30" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-u_ok" target="pipeline-u_deploy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-u_deploy" target="pipeline-u_live"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-u_live" target="pipeline-u_push"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e33" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-u_push" target="pipeline-u_nopush"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e34" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-u_push" target="pipeline-u_send"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-u_send" target="pipeline-u_house"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="pipeline-e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipeline-u_nopush" target="pipeline-u_house"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1640" y="875"/></Array></mxGeometry></mxCell>
        <mxCell id="pipeline-e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="pipeline-u_house" target="pipeline-u_end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
