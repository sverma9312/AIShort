  <diagram id="data" name="3. Data Model &amp; Feed Contract">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="data-title" value="Data Model (Supabase Postgres) &amp; Public Feed Contract" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="data-sources" value="&lt;b&gt;sources&lt;/b&gt;&lt;hr&gt;id  uuid PK&lt;br&gt;name  text&lt;br&gt;kind  rss | algolia | hf | html&lt;br&gt;url  text&lt;br&gt;weight  int (authority)&lt;br&gt;category_hint  text&lt;br&gt;enabled  bool&lt;br&gt;created_at  timestamptz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="data-health" value="&lt;b&gt;source_health&lt;/b&gt;&lt;hr&gt;source_id  uuid PK, FK → sources&lt;br&gt;etag  text&lt;br&gt;last_modified  text&lt;br&gt;last_ok_at  timestamptz&lt;br&gt;last_error  text&lt;br&gt;consecutive_failures  int" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="300" height="136" as="geometry"/></mxCell>
        <mxCell id="data-articles" value="&lt;b&gt;articles&lt;/b&gt;&lt;hr&gt;id  uuid PK&lt;br&gt;source_id  uuid FK → sources&lt;br&gt;url_canonical  text UNIQUE&lt;br&gt;url_hash  text (index)&lt;br&gt;title  text (trigram index)&lt;br&gt;published_at  timestamptz&lt;br&gt;raw_text  text (pruned after 30 d)&lt;br&gt;embedding  vector(768)&lt;br&gt;cluster_id  uuid FK → clusters&lt;br&gt;status  new | rejected | carded&lt;br&gt;fetched_at  timestamptz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="320" height="221" as="geometry"/></mxCell>
        <mxCell id="data-clusters" value="&lt;b&gt;clusters&lt;/b&gt;&lt;hr&gt;id  uuid PK&lt;br&gt;primary_article_id  uuid FK → articles&lt;br&gt;first_seen_at  timestamptz&lt;br&gt;article_count  int" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="320" height="102" as="geometry"/></mxCell>
        <mxCell id="data-cards" value="&lt;b&gt;cards&lt;/b&gt;&lt;hr&gt;id  uuid PK&lt;br&gt;cluster_id  uuid FK → clusters (UNIQUE)&lt;br&gt;headline  text (≤ 12 words)&lt;br&gt;summary  text (≤ 60 words)&lt;br&gt;category  models | research | products |&lt;br&gt;               business | policy | open-source&lt;br&gt;importance  smallint 1–10&lt;br&gt;image_url  text&lt;br&gt;source_name  text&lt;br&gt;source_url  text&lt;br&gt;published_at  timestamptz&lt;br&gt;hidden  bool (editor kill switch)&lt;br&gt;llm_provider  text&lt;br&gt;created_at  timestamptz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="300" width="320" height="272" as="geometry"/></mxCell>
        <mxCell id="data-tokens" value="&lt;b&gt;push_tokens&lt;/b&gt;&lt;hr&gt;token  text PK&lt;br&gt;platform  ios | android&lt;br&gt;created_at  timestamptz&lt;br&gt;last_seen_at  timestamptz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="90" width="340" height="102" as="geometry"/></mxCell>
        <mxCell id="data-pushlog" value="&lt;b&gt;push_log&lt;/b&gt;&lt;hr&gt;id  uuid PK&lt;br&gt;card_id  uuid FK → cards&lt;br&gt;sent_at  timestamptz&lt;br&gt;recipients  int" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="300" width="340" height="102" as="geometry"/></mxCell>
        <mxCell id="data-e1" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="data-health" target="data-sources"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="data-e2" value="n : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="data-articles" target="data-sources"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="data-e3" value="n : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="data-articles" target="data-clusters"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="data-e4" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="data-cards" target="data-clusters"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="data-e5" value="n : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="data-pushlog" target="data-cards"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="data-rls" value="&lt;b&gt;Access rules&lt;/b&gt;&lt;br&gt;• Pipeline uses the service-role key (GitHub Secret) — full access.&lt;br&gt;• App uses the anon key: INSERT only on push_tokens (RLS); no SELECT on any table.&lt;br&gt;• Users never read the database — they read static JSON from GitHub Pages.&lt;br&gt;• Editor uses Supabase Studio: set cards.hidden = true → next run republishes without it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="700" height="120" as="geometry"/></mxCell>
        <mxCell id="data-retention" value="&lt;b&gt;Retention (stays far below the 500 MB free limit)&lt;/b&gt;&lt;br&gt;raw_text nulled after 30 days · rejected articles deleted after 30 days&lt;br&gt;cards kept forever (~50 MB/year) · archive JSON is immutable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="700" height="80" as="geometry"/></mxCell>
        <mxCell id="data-j_latest" value="&lt;b&gt;GET /v1/feed/latest.json&lt;/b&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;version&quot;: 1,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;generatedAt&quot;: &quot;2026-10-28T09:30:00Z&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;cards&quot;: [{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;id&quot;: &quot;c_8f3a…&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;headline&quot;: &quot;…&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;summary&quot;: &quot;… (≤ 60 words)&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;category&quot;: &quot;models&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;importance&quot;: 8,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;sourceName&quot;: &quot;OpenAI&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;sourceUrl&quot;: &quot;https://…&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;imageUrl&quot;: &quot;https://…&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;publishedAt&quot;: &quot;2026-10-28T08:12:00Z&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;}]&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="360" height="330" as="geometry"/></mxCell>
        <mxCell id="data-j_meta" value="&lt;b&gt;GET /v1/meta.json&lt;/b&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;version&quot;: 1,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;minAppVersion&quot;: &quot;1.0.0&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;feedBaseUrls&quot;: [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;https://&amp;lt;user&amp;gt;.github.io/AIShort&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;categories&quot;: [&quot;models&quot;, &quot;research&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;products&quot;, &quot;business&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;policy&quot;, &quot;open-source&quot;]&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1220" y="600" width="340" height="230" as="geometry"/></mxCell>
        <mxCell id="data-j_note" value="Both files are validated by the same Zod schema in packages/shared — the pipeline refuses to publish, and the app refuses to render, anything that doesn&#x27;t match. Archive pages (/v1/feed/archive/YYYY-MM-DD.json) use the same shape." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="850" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="data-e6" value="published as" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="data-cards" target="data-j_latest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="app" name="4. Mobile App">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="app-title" value="Mobile App — Screens &amp; Feed Data Flow (Expo)" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="app-g_screens" value="Screens (Expo Router, file-based)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="560" height="620" as="geometry"/></mxCell>
        <mxCell id="app-root" value="&lt;b&gt;app/_layout.tsx&lt;/b&gt;&lt;br&gt;QueryClientProvider · Theme · Sentry · PostHog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="520" height="55" as="geometry"/></mxCell>
