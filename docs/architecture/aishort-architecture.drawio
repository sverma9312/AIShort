        <mxCell id="overview-src_note" value="&lt;b&gt;Avoid:&lt;/b&gt; NewsAPI free tier (dev-only), Reddit API (commercial terms), Google News scraping.&lt;br&gt;&lt;br&gt;&lt;b&gt;Always:&lt;/b&gt; write original summaries, attribute + link every card, respect robots.txt, don&#x27;t republish full text." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="280" height="190" as="geometry"/></mxCell>
